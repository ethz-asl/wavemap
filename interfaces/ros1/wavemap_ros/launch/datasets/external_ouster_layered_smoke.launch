<launch>
  <arg name="bag"
       default="/home/ci/data/external_bag/2026_03_04_11_08_52__linhas-ren-curt_points_ros1_4min.bag"/>
  <arg name="duration" default="15"/>
  <arg name="rate" default="0.25"/>
  <arg name="run_ig_lio" default="true"/>
  <arg name="show_rviz" default="false"/>

  <param name="/use_sim_time" value="true"/>

  <!-- This bag has calibrated static sensor transforms but no map-to-body
       trajectory. IG-LIO supplies only that missing live pose. Do not include
       its stock Ouster launch here: it also publishes a zero sensor extrinsic
       which would conflict with the transform already stored in this bag. -->
  <group if="$(arg run_ig_lio)">
    <rosparam command="load" file="$(find ig_lio)/config/ouster128.yaml"/>
    <node pkg="ig_lio" type="ig_lio_node" name="ig_lio_node"
          output="screen"/>
  </group>

  <include file="$(find wavemap_ros)/launch/wavemap_server.launch">
    <arg name="server_type" value="reflectivity_class_layered_server"/>
    <arg name="param_file"
         value="$(find wavemap_ros)/config/wavemap_ouster_reflectivity_layered.yaml"/>
    <arg name="show_rviz" value="$(arg show_rviz)"/>
  </include>

  <!-- Limit the smoke test to mapping inputs. The bag also contains several
       high-bandwidth camera streams that are irrelevant for this map. -->
  <node pkg="rosbag" type="play" name="layered_smoke_player" output="screen"
        args="--quiet --clock -r $(arg rate) --duration=$(arg duration) $(arg bag)
              --topics /ouster/points /ouster/imu /tf /tf_static"/>
</launch>
