<launch>
  <arg name="bag"
       default="/home/ci/data/external_bag/2026_03_04_11_08_52__linhas-ren-curt_points_ros1_4min.bag"/>
  <arg name="duration" default="10"/>
  <arg name="rate" default="0.1"/>
  <arg name="run_ig_lio" default="true"/>
  <arg name="show_rviz" default="false"/>

  <param name="/use_sim_time" value="true"/>

  <!-- This bag lacks the live map-to-body trajectory. IG-LIO supplies it;
       the original occupancy-only Wavemap pipeline remains unchanged. -->
  <group if="$(arg run_ig_lio)">
    <rosparam command="load" file="$(find ig_lio)/config/ouster128.yaml"/>
    <node pkg="ig_lio" type="ig_lio_node" name="ig_lio_node"
          output="screen"/>
  </group>

  <include file="$(find wavemap_ros)/launch/wavemap_server.launch">
    <arg name="param_file"
         value="$(find wavemap_ros)/config/wavemap_ouster_occupancy_only.yaml"/>
    <arg name="show_rviz" value="$(arg show_rviz)"/>
  </include>

  <node pkg="rosbag" type="play" name="occupancy_validation_player"
        output="screen"
        args="--quiet --clock -r $(arg rate) --duration=$(arg duration) $(arg bag)
              --topics /ouster/points /ouster/imu /tf /tf_static"/>
</launch>
